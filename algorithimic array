class Solution:
    def mergeKArrays(self, lists):
        k = len(lists)
        index = [0] * k
        result = []

        while True:
            min_val = float('inf')
            min_index = -1

            for i in range(k):
                if index[i] < len(lists[i]) and lists[i][index[i]] < min_val:
                    min_val = lists[i][index[i]]
                    min_index = i

            if min_index == -1:
                break

            result.append(min_val)
            index[min_index] += 1

        return result


# Example
lists = [[1, 4, 5], [1, 3, 4], [2, 6]]

sol = Solution()
print(sol.mergeKArrays(lists))
